# SQLite is the local default. Set a Postgres URL to use Postgres instead.
DATABASE_URL=sqlite:///data/your_next_travel.db
# DATABASE_URL=postgresql+psycopg://travel:travel@127.0.0.1:5432/your_next_travel

# Angular portal origin(s). The API does not serve HTML.
CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

# JWT for API auth. Change this before any public deploy.
JWT_SECRET=change-me-for-any-public-deploy

# Preference packs (SKILL.md files). Default: data/travel-skills/<user-id>/
# PREFERENCES_SKILLS_DIR=data/travel-skills

# Local Ollama. Override if the daemon is not on this machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_HOST=127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_MODELS=llama3.2,qwen2.5
